---
import Sidebar from "../components/Sidebar.astro";
import MobileHeader from "../components/MobileHeader.astro";
import Footer from "../components/Footer.astro";

interface Props {
  pageType?: "home" | "post" | "about" | "search";
  sidebarOpacity?: number;
}

const { pageType = "home", sidebarOpacity = 1 } = Astro.props;
---

<a href="#main-content" class="sr-only sr-only-focusable">본문으로 건너뛰기</a>
<MobileHeader />
<div
  class="layout-wrapper"
  data-page-type={pageType}
  data-pagefind-ignore={pageType !== "post" ? "all" : undefined}
>
  <aside
    id="sidebar"
    class="sidebar"
    style={sidebarOpacity !== 1
      ? `--sidebar-opacity: ${sidebarOpacity}`
      : undefined}
  >
    <Sidebar />
  </aside>
  <main id="main-content" class="main-content">
    <slot />
  </main>
  <aside id="aside-panel" class="aside-panel">
    <slot name="aside" />
  </aside>
  <Footer />
</div>
<div class="layout-overlay" id="layout-overlay"></div>

<script>
  const sidebar = document.querySelector(".sidebar") as HTMLElement | null;
  const asidePanel = document.querySelector(
    ".aside-panel",
  ) as HTMLElement | null;
  const sidebarToggle = document.getElementById("sidebar-toggle");
  const asideToggle = document.getElementById("aside-toggle");
  const overlay = document.getElementById("layout-overlay");

  const FOCUSABLE_SELECTOR =
    'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
  // 600px 미만(true mobile)만 모달 — 600~1339는 hover-reveal, 1340+는 sticky 3-column
  const MODAL_QUERY = "(max-width: 599px)";

  type OpenOpts = { viaKeyboard?: boolean };
  type CloseOpts = { restoreFocus?: boolean };

  let lastTrigger: HTMLElement | null = null;

  function isModal() {
    return window.matchMedia(MODAL_QUERY).matches;
  }

  function getFocusables(panel: HTMLElement | null) {
    if (!panel) return [] as HTMLElement[];
    return Array.from(
      panel.querySelectorAll<HTMLElement>(FOCUSABLE_SELECTOR),
    ).filter((el) => !el.hasAttribute("inert") && el.offsetParent !== null);
  }

  function syncAria() {
    sidebarToggle?.setAttribute(
      "aria-expanded",
      String(!!sidebar?.classList.contains("is-active")),
    );
    asideToggle?.setAttribute(
      "aria-expanded",
      String(!!asidePanel?.classList.contains("is-active")),
    );
  }

  function applyInert() {
    if (!isModal()) {
      sidebar?.removeAttribute("inert");
      asidePanel?.removeAttribute("inert");
      return;
    }
    if (sidebar)
      sidebar.toggleAttribute("inert", !sidebar.classList.contains("is-active"));
    if (asidePanel)
      asidePanel.toggleAttribute(
        "inert",
        !asidePanel.classList.contains("is-active"),
      );
  }

  function syncBody() {
    const anyActive =
      !!sidebar?.classList.contains("is-active") ||
      !!asidePanel?.classList.contains("is-active");
    document.body.classList.toggle("panel-active", anyActive);
    overlay?.classList.toggle("is-visible", anyActive);
    syncAria();
    applyInert();
  }

  function reveal(panel: HTMLElement | null, opts: OpenOpts = {}) {
    if (!panel) return;
    const other = panel === sidebar ? asidePanel : sidebar;
    other?.classList.remove("is-active");
    panel.classList.add("is-active");
    syncBody();
    if (opts.viaKeyboard) {
      const focusables = getFocusables(panel);
      focusables[0]?.focus();
    }
  }

  function closePanel(panel: HTMLElement | null, opts: CloseOpts = {}) {
    if (!panel) return;
    panel.classList.remove("is-active");
    syncBody();
    if (opts.restoreFocus && lastTrigger) {
      lastTrigger.focus();
      lastTrigger = null;
    }
  }

  function closeAll() {
    sidebar?.classList.remove("is-active");
    asidePanel?.classList.remove("is-active");
    syncBody();
  }

  // 초기 ARIA 상태 동기화
  syncBody();

  sidebar?.addEventListener("pointerenter", (e) => {
    if (e.pointerType === "touch") return;
    reveal(sidebar);
  });
  sidebar?.addEventListener("pointerleave", (e) => {
    if (e.pointerType === "touch") return;
    closePanel(sidebar);
  });
  asidePanel?.addEventListener("pointerenter", (e) => {
    if (e.pointerType === "touch") return;
    reveal(asidePanel);
  });
  asidePanel?.addEventListener("pointerleave", (e) => {
    if (e.pointerType === "touch") return;
    closePanel(asidePanel);
  });

  sidebar?.addEventListener("click", () => reveal(sidebar));
  asidePanel?.addEventListener("click", () => reveal(asidePanel));

  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    if (sidebarToggle?.contains(target) || asideToggle?.contains(target)) {
      return;
    }
    if (sidebar && !sidebar.contains(target)) {
      closePanel(sidebar);
    }
    if (asidePanel && !asidePanel.contains(target)) {
      closePanel(asidePanel);
    }
  });

  sidebarToggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    if (sidebar?.classList.contains("is-active")) {
      closePanel(sidebar, { restoreFocus: true });
    } else {
      lastTrigger = sidebarToggle as HTMLElement;
      reveal(sidebar, { viaKeyboard: true });
    }
  });

  asideToggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    if (asidePanel?.classList.contains("is-active")) {
      closePanel(asidePanel, { restoreFocus: true });
    } else {
      lastTrigger = asideToggle as HTMLElement;
      reveal(asidePanel, { viaKeyboard: true });
    }
  });

  overlay?.addEventListener("click", closeAll);

  // Esc로 열린 패널 닫기
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (sidebar?.classList.contains("is-active")) {
      closePanel(sidebar, { restoreFocus: true });
    } else if (asidePanel?.classList.contains("is-active")) {
      closePanel(asidePanel, { restoreFocus: true });
    }
  });

  // 모달 모드에서 Tab 포커스 트랩
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Tab") return;
    if (!isModal()) return;
    const activePanel = sidebar?.classList.contains("is-active")
      ? sidebar
      : asidePanel?.classList.contains("is-active")
        ? asidePanel
        : null;
    if (!activePanel) return;
    const focusables = getFocusables(activePanel);
    if (focusables.length === 0) {
      e.preventDefault();
      return;
    }
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    const current = document.activeElement as HTMLElement | null;
    if (e.shiftKey && current === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && current === last) {
      e.preventDefault();
      first.focus();
    }
  });

  const SWIPE_THRESHOLD = 50;
  let touchStartX = 0;
  let touchStartY = 0;
  let isSwiping = false;

  function hasHorizontalScrollableAncestor(target: EventTarget | null): boolean {
    let node = target as HTMLElement | null;
    while (node && node !== document.body) {
      if (node.nodeType === 1) {
        const style = window.getComputedStyle(node);
        const overflowX = style.overflowX;
        if (
          (overflowX === "auto" || overflowX === "scroll") &&
          node.scrollWidth > node.clientWidth
        ) {
          return true;
        }
      }
      node = node.parentElement;
    }
    return false;
  }

  document.addEventListener(
    "touchstart",
    (e) => {
      if (hasHorizontalScrollableAncestor(e.target)) {
        isSwiping = false;
        return;
      }
      const touch = e.touches[0];
      touchStartX = touch.clientX;
      touchStartY = touch.clientY;
      isSwiping = true;
    },
    { passive: true },
  );

  document.addEventListener(
    "touchend",
    (e) => {
      if (!isSwiping) return;
      isSwiping = false;

      const touch = e.changedTouches[0];
      const dx = touch.clientX - touchStartX;
      const dy = touch.clientY - touchStartY;

      if (Math.abs(dy) > Math.abs(dx)) return;
      if (Math.abs(dx) < SWIPE_THRESHOLD) return;

      const sidebarActive = sidebar?.classList.contains("is-active");
      const asideActive = asidePanel?.classList.contains("is-active");

      if (dx > 0) {
        if (asideActive) {
          closePanel(asidePanel);
        } else if (!sidebarActive) {
          reveal(sidebar);
        }
      } else {
        if (sidebarActive) {
          closePanel(sidebar);
        } else if (!asideActive) {
          reveal(asidePanel);
        }
      }
    },
    { passive: true },
  );

  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener("resize", () => {
    document.body.classList.add("is-resizing");
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      document.body.classList.remove("is-resizing");
    }, 150);
  });
</script>
