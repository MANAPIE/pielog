---
import BaseHead from "../components/BaseHead.astro";
import ThreeColumnLayout from "./ThreeColumnLayout.astro";
import "../styles/global.scss";

interface Props {
    title: string;
    description: string;
    ogImage?: string;
    pageType?: 'home' | 'post' | 'about' | 'search';
    sidebarOpacity?: number;
}

const { title, description, ogImage, pageType = 'home', sidebarOpacity = 1 } = Astro.props;
---

<!doctype html>
<html lang="ko">
    <head>
        <BaseHead title={title} description={description} ogImage={ogImage} />
    </head>
    <body>
        <ThreeColumnLayout pageType={pageType} sidebarOpacity={sidebarOpacity}>
            <slot />
            <slot name="aside" slot="aside" />
        </ThreeColumnLayout>
    </body>
</html>
