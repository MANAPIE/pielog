---
import BaseLayout from "./BaseLayout.astro";
import Giscus from "../components/Giscus.astro";
import TableOfContents from "../components/TableOfContents.astro";
import "github-markdown-css/github-markdown-light.css";

interface Props {
    title: string;
    description: string;
    date: Date;
    tags?: string[];
    ogImage?: string;
    headings?: { depth: number; slug: string; text: string }[];
}

const {
    title,
    description,
    date,
    tags = [],
    ogImage,
    headings = [],
} = Astro.props;
---

<BaseLayout
    title={`${title} - PIElog`}
    description={description}
    ogImage={ogImage}
    pageType="post"
    sidebarOpacity={0.2}
>
    <article>
        <header class="post-header">
            {
                tags.length > 0 && (
                    <div class="post-tags">
                        {tags.map((tag) => (
                            <a href={`/tags/${tag}/`} class="post-tag">
                                {tag}
                            </a>
                        ))}
                    </div>
                )
            }
            <h1>{title}</h1>
            <div class="post-meta">
                <time datetime={date.toISOString()}>
                    {
                        date.toLocaleDateString("ko-KR", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })
                    }
                </time>
                <!-- <span class="post-views" id="post-views"></span> -->
            </div>
        </header>
        <div class="post-content markdown-body">
            <slot />
        </div>
    </article>
    <Giscus />
    <TableOfContents headings={headings} slot="aside" />
</BaseLayout>

<script>
    const slug = window.location.pathname.replace(/^\/|\/$/g, "");
    fetch("/api/views", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ slug }),
    })
        .then((r) => r.json())
        .then((data) => {
            const el = document.getElementById("post-views");
            if (el) el.textContent = `${data.views.toLocaleString()} views`;
        })
        .catch(() => {});
</script>

<style lang="scss">
    @use "../styles/_variables.scss" as *;

    .post-meta {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .post-tags {
        margin: 1px 0 2px;
    }

    .post-tag {
        color: $color-primary;
        display: inline-block;
        white-space: nowrap;
        padding: 0 8px;
        margin-right: 8px;
        margin-bottom: 8px;
        background: $color-tree;
        border: 1px solid $color-border;
        border-radius: 3px;
        font-family: "Courier New", Courier, monospace;
        font-weight: bold;
        font-size: 11px;
        text-decoration: none;

        &:hover {
            text-decoration: underline;
        }
    }
</style>
