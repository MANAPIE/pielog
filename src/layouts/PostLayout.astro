---
import type { ImageMetadata } from "astro";
import BaseLayout from "./BaseLayout.astro";
import Giscus from "../components/Giscus.astro";
import TableOfContents from "../components/TableOfContents.astro";

interface Props {
    title: string;
    description: string;
    date: Date;
    tags?: string[];
    ogImage?: string;
    headings?: { depth: number; slug: string; text: string }[];
    searchIndex?: string;
    summary?: string;
    thumbnail?: ImageMetadata;
}

const {
    title,
    description,
    date,
    tags = [],
    ogImage,
    headings = [],
    searchIndex = "",
    summary,
    thumbnail,
} = Astro.props;
---

<BaseLayout
    title={`${title} - PIElog`}
    description={description}
    ogImage={ogImage}
    pageType="post"
    sidebarOpacity={0.2}
>
    <script is:inline>
      (function () {
        var theme = document.documentElement.getAttribute('data-theme') || 'light';
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.id = 'markdown-theme-css';
        link.href = 'https://cdn.jsdelivr.net/npm/github-markdown-css@5.9.0/github-markdown-' + theme + '.css';
        document.head.appendChild(link);
      })();
    </script>
    <div data-pagefind-body hidden aria-hidden="true" style="display:none">
        <h1 data-pagefind-meta="title" data-pagefind-weight="10">{title}</h1>
        <p data-pagefind-meta="description">{description}</p>
        {summary && <p data-pagefind-meta="summary">{summary}</p>}
        {thumbnail && (
            <img data-pagefind-meta="thumbnail[src]" src={thumbnail.src} alt="" />
        )}
        <p data-pagefind-meta={`date:${date.toISOString()}`}></p>
        {tags.map((tag) => (
            <span data-pagefind-filter="tag">{tag}</span>
        ))}
        <p>{searchIndex}</p>
        <p>pielog 파이로그</p>
    </div>
    <article data-pagefind-ignore="all">
        <header class="post-header">
            {
                tags.length > 0 && (
                    <div class="post-tags">
                        {tags.map((tag) => (
                            <a href={`/tags/${tag}/`} class="post-tag">
                                {tag}
                            </a>
                        ))}
                    </div>
                )
            }
            <h1>{title}</h1>
            <div class="post-meta">
                <time datetime={date.toISOString()}>
                    {
                        date.toLocaleDateString("ko-KR", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })
                    }
                </time>
                <!-- <span class="post-views" id="post-views"></span> -->
            </div>
        </header>
        <div class="post-content markdown-body">
            <slot />
        </div>
    </article>
    <Giscus />
    <TableOfContents headings={headings} slot="aside" />
</BaseLayout>

<script>
    const slug = window.location.pathname.replace(/^\/|\/$/g, "");
    fetch("/api/views/", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ slug }),
    })
        .then((r) => r.json())
        .then((data) => {
            const el = document.getElementById("post-views");
            if (el) el.textContent = `${data.views.toLocaleString()} views`;
        })
        .catch(() => {});
</script>

<style lang="scss">
    .post-meta {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .post-tags {
        margin: 1px 0 2px;
    }
</style>
