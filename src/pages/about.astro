---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="About — PIElog"
    description="MANAPIE의 블로그 PIElog를 소개합니다. // thoughts & experiments_"
    pageType="about"
>
    <article class="about">
        <!-- ============ HERO ============ -->
        <header class="about-hero">
            <svg
                class="about-hero-bg"
                viewBox="0 0 820 420"
                preserveAspectRatio="xMidYMid slice"
                aria-hidden="true"
            >
                <defs>
                    <pattern
                        id="about-dots"
                        x="0"
                        y="0"
                        width="24"
                        height="24"
                        patternUnits="userSpaceOnUse"
                    >
                        <circle cx="12" cy="12" r="1.2" fill="var(--color-dot)"
                        ></circle>
                    </pattern>
                    <radialGradient
                        id="about-halo-a"
                        cx="0.85"
                        cy="0.15"
                        r="0.7"
                    >
                        <stop
                            offset="0"
                            stop-color="var(--color-accent)"
                            stop-opacity="0.28"></stop>
                        <stop
                            offset="1"
                            stop-color="var(--color-accent)"
                            stop-opacity="0"></stop>
                    </radialGradient>
                    <radialGradient
                        id="about-halo-b"
                        cx="0.08"
                        cy="0.92"
                        r="0.6"
                    >
                        <stop
                            offset="0"
                            stop-color="var(--color-accent-3)"
                            stop-opacity="0.34"></stop>
                        <stop
                            offset="1"
                            stop-color="var(--color-accent-3)"
                            stop-opacity="0"></stop>
                    </radialGradient>
                </defs>

                <rect width="820" height="420" fill="url(#about-dots)"></rect>
                <rect width="820" height="420" fill="url(#about-halo-a)"></rect>
                <rect width="820" height="420" fill="url(#about-halo-b)"></rect>

                <circle
                    cx="740"
                    cy="60"
                    r="240"
                    fill="none"
                    stroke="var(--color-line)"
                    stroke-width="1.4"></circle>
                <circle
                    cx="740"
                    cy="60"
                    r="170"
                    fill="none"
                    stroke="var(--color-line)"
                    stroke-width="1.4"></circle>
                <circle
                    cx="740"
                    cy="60"
                    r="100"
                    fill="none"
                    stroke="var(--color-line)"
                    stroke-width="1.4"></circle>
                <circle
                    cx="90"
                    cy="380"
                    r="190"
                    fill="none"
                    stroke="var(--color-line)"
                    stroke-width="1.4"></circle>

                <g transform="rotate(-9 410 210)">
                    <rect
                        x="640"
                        y="240"
                        width="200"
                        height="200"
                        fill="none"
                        stroke="var(--color-line)"
                        stroke-width="1.4"
                        stroke-dasharray="4 8"></rect>
                </g>

                <circle
                    cx="660"
                    cy="300"
                    r="22"
                    fill="var(--color-accent)"
                    fill-opacity="0.18"></circle>
                <circle
                    cx="660"
                    cy="300"
                    r="22"
                    fill="none"
                    stroke="var(--color-accent)"
                    stroke-width="1.4"
                    stroke-dasharray="3 5"></circle>
                <circle cx="700" cy="320" r="7" fill="var(--color-accent-2)"
                ></circle>
                <circle cx="630" cy="340" r="4" fill="var(--color-accent)"
                ></circle>
                <circle cx="690" cy="350" r="5" fill="var(--color-accent-3)"
                ></circle>

                <rect
                    x="40"
                    y="60"
                    width="38"
                    height="10"
                    rx="5"
                    fill="var(--color-accent-2)"
                    fill-opacity="0.55"></rect>
                <rect
                    x="40"
                    y="76"
                    width="22"
                    height="6"
                    rx="3"
                    fill="var(--color-accent-3)"
                    fill-opacity="0.7"></rect>

                <line
                    x1="120"
                    y1="220"
                    x2="220"
                    y2="220"
                    stroke="var(--color-accent)"
                    stroke-width="1.4"
                    stroke-dasharray="4 6"
                    stroke-opacity="0.6"></line>
                <line
                    x1="120"
                    y1="240"
                    x2="180"
                    y2="240"
                    stroke="var(--color-accent)"
                    stroke-width="1.4"
                    stroke-opacity="0.4"></line>
            </svg>

            <div class="about-hero-inner">
                <span class="about-eyebrow">
                    <span class="about-eyebrow-dot"></span>
                    // thoughts &amp; experiments_
                </span>
                <h1 class="about-title">
                    About<span class="about-title-dot">.</span>
                </h1>
                <p class="about-lede">
                    PIElog는 <strong>파이(MANAPIE)</strong>가 여러 경계에서
                    마주친 문제들을 기록하는 블로그입니다.<br />
                    정리된 결론도 있지만, <em>// thoughts &amp; experiments_</em
                    >라는 부제 그대로, 진행 중인 실험과 부서진 지점도 함께
                    공유하고 싶습니다.
                </p>

                <div class="about-hero-meta">
                    <div class="about-hero-card">
                        <svg
                            class="about-hero-card-icon"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >
                            <circle
                                cx="12"
                                cy="12"
                                r="10"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.6"></circle>
                            <circle cx="12" cy="12" r="4" fill="currentColor"
                            ></circle>
                        </svg>
                        <div>
                            <span class="about-hero-card-label">Editor</span>
                            <strong>MANAPIE</strong>
                        </div>
                    </div>
                    <div class="about-hero-card">
                        <svg
                            class="about-hero-card-icon"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >
                            <rect
                                x="3"
                                y="3"
                                width="18"
                                height="18"
                                rx="3"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.6"></rect>
                            <path
                                d="M3 9 H21"
                                stroke="currentColor"
                                stroke-width="1.6"></path>
                            <circle
                                cx="6.5"
                                cy="6.5"
                                r="0.8"
                                fill="currentColor"></circle>
                            <circle
                                cx="9.5"
                                cy="6.5"
                                r="0.8"
                                fill="currentColor"></circle>
                        </svg>
                        <div>
                            <span class="about-hero-card-label">Since</span>
                            <strong>2026 → now</strong>
                        </div>
                    </div>
                    <div class="about-hero-card">
                        <svg
                            class="about-hero-card-icon"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >
                            <path
                                d="M4 18 L10 10 L14 14 L20 6"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.6"
                                stroke-linecap="round"
                                stroke-linejoin="round"></path>
                            <circle cx="20" cy="6" r="1.6" fill="currentColor"
                            ></circle>
                        </svg>
                        <div>
                            <span class="about-hero-card-label">Stance</span>
                            <strong>π-shaped</strong>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- ============ WHY PIELOG ============ -->
        <section class="about-section">
            <header class="about-section-head">
                <span class="about-section-num">01</span>
                <div>
                    <span class="about-section-kicker">manifesto</span>
                    <h2>Why PIElog</h2>
                </div>
                <svg
                    class="about-section-glyph"
                    viewBox="0 0 60 60"
                    aria-hidden="true"
                >
                    <rect
                        x="6"
                        y="6"
                        width="22"
                        height="22"
                        rx="3"
                        fill="var(--color-accent)"
                        fill-opacity="0.18"
                        stroke="var(--color-accent)"
                        stroke-width="1.4"></rect>
                    <rect
                        x="32"
                        y="10"
                        width="18"
                        height="18"
                        rx="3"
                        fill="var(--color-accent-2)"
                        fill-opacity="0.4"
                        stroke="var(--color-accent-2)"
                        stroke-width="1.4"
                        transform="rotate(8 41 19)"></rect>
                    <rect
                        x="10"
                        y="32"
                        width="16"
                        height="16"
                        rx="3"
                        fill="none"
                        stroke="var(--color-accent)"
                        stroke-width="1.4"
                        stroke-dasharray="3 4"
                        transform="rotate(-6 18 40)"></rect>
                    <rect
                        x="30"
                        y="32"
                        width="22"
                        height="22"
                        rx="3"
                        fill="var(--color-accent-3)"
                        fill-opacity="0.55"
                        stroke="var(--color-accent)"
                        stroke-width="1.4"></rect>
                    <circle cx="30" cy="30" r="3" fill="var(--color-accent)"
                    ></circle>
                </svg>
            </header>

            <p>
                부서져 본 사람만이 다시 조립할 수 있고, 다시 조립한 경험만이
                자산이 됩니다.<br />
                하지만 실무에서 부서지고 다시 조립한 것들은 시간이 지나면 흩어지고
                맙니다.
            </p>
            <p>
                흩어지기 전에 붙들어 두는 일, 그리고 같은 자리를 지나고 있을
                누군가의 손에 닿게 두는 일.<br />
                이 블로그가 자리한 이유입니다.
            </p>

            <blockquote class="about-quote">
                <svg viewBox="0 0 28 28" aria-hidden="true">
                    <path
                        d="M6 16 Q6 8 14 8 M16 16 Q16 8 24 8"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"></path>
                </svg>
                <p>
                    여기서는 사람과 기계, 사용자와 시스템, 그리고 디자인과
                    개발이 한 사람 안에서 동시에 일어납니다.<br />
                    디자인을 이야기하는 글에도 코드가 비집고 들어오고, 개발을 이야기하는
                    글에도 사용자의 얼굴이 어른거립니다.<br />
                    둘을 가지런히 나눌 수 있을 때도 있지만, 굳이 나누지 않습니다.
                </p>
            </blockquote>
        </section>

        <!-- ============ MANAPIE ============ -->
        <section class="about-section about-section--portrait">
            <header class="about-section-head">
                <span class="about-section-num">02</span>
                <div>
                    <span class="about-section-kicker">profile</span>
                    <h2>파이 (MANAPIE)</h2>
                </div>
                <svg
                    class="about-section-glyph about-section-glyph--pi"
                    viewBox="0 0 60 60"
                    aria-hidden="true"
                >
                    <path
                        d="M8 18 H52"
                        stroke="var(--color-accent)"
                        stroke-width="3"
                        stroke-linecap="round"></path>
                    <path
                        d="M20 18 V52"
                        stroke="var(--color-accent)"
                        stroke-width="3"
                        stroke-linecap="round"></path>
                    <path
                        d="M40 18 V52"
                        stroke="var(--color-accent)"
                        stroke-width="3"
                        stroke-linecap="round"></path>
                    <circle cx="20" cy="54" r="3" fill="var(--color-accent-2)"
                    ></circle>
                    <circle cx="40" cy="54" r="3" fill="var(--color-accent-2)"
                    ></circle>
                    <circle cx="48" cy="14" r="2" fill="var(--color-accent-3)"
                    ></circle>
                </svg>
            </header>

            <div class="about-portrait">
                <figure
                    class="about-portrait-figure"
                    aria-label="프로필 이미지"
                >
                    <div class="about-portrait-frame">
                        <svg viewBox="0 0 200 240" aria-hidden="true">
                            <rect
                                width="200"
                                height="240"
                                fill="var(--color-surface)"></rect>
                            <circle
                                cx="100"
                                cy="92"
                                r="46"
                                fill="var(--color-accent)"
                                fill-opacity="0.18"></circle>
                            <circle
                                cx="100"
                                cy="92"
                                r="46"
                                fill="none"
                                stroke="var(--color-accent)"
                                stroke-width="1.6"
                                stroke-dasharray="3 5"></circle>
                            <path
                                d="M40 230 Q100 150 160 230 Z"
                                fill="var(--color-accent)"
                                fill-opacity="0.18"></path>
                            <path
                                d="M40 230 Q100 150 160 230"
                                fill="none"
                                stroke="var(--color-accent)"
                                stroke-width="1.6"></path>
                        </svg>
                        <figcaption>PIE 입니다. PI가 아닙니다.</figcaption>
                    </div>
                    <div class="about-portrait-tags">
                        <span
                            ><svg viewBox="0 0 14 14" aria-hidden="true"
                                ><path
                                    d="M3 7 L6 10 L11 4"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"></path></svg
                            >Computer Science</span
                        >
                        <span
                            ><svg viewBox="0 0 14 14" aria-hidden="true"
                                ><path
                                    d="M3 7 L6 10 L11 4"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"></path></svg
                            >Visual Communication Design</span
                        >
                        <span class="is-accent"
                            ><svg viewBox="0 0 14 14" aria-hidden="true"
                                ><circle cx="7" cy="7" r="3" fill="currentColor"
                                ></circle></svg
                            >Design Engineer</span
                        >
                    </div>
                </figure>

                <div class="about-portrait-body">
                    <p>
                        컴퓨터공학과 시각디자인학을 함께 전공했습니다.<br />
                        한쪽을 부전공으로 거친 게 아니라, 두 길을 끝까지 함께 걸어
                        졸업했습니다. <br />
                        디자인을 모르는 개발자도, 코드를 모르는 디자이너도 아닙니다.
                    </p>

                    <div class="about-pi-card">
                        <div class="about-pi-card-head">
                            <span class="about-pi-glyph">π</span>
                            <div>
                                <strong>π-shaped</strong>
                                <span>두 분야에 동시에 깊이를 가진 사람</span>
                            </div>
                        </div>
                        <p>
                            T자형 인재가 한 분야의 깊이를 가진 사람이라면, 두
                            분야의 동시에 깊이를 가진 사람을
                            <strong>π-shaped</strong>라고 부릅니다. <br />
                            한국어로는 <strong>풀스택 개자이너</strong> (개발자+디자이너),
                            영어로는 <strong>Design Engineer</strong>. <br />
                            저는 그렇게 불려왔지만, 지금은 그 이름들이 다 담아내지
                            못하는 자리에 있습니다. <br />
                            앞으로는 나무 뿌리만큼 더 깊게 더 넓게 뻗어나가려고 합니다.
                        </p>
                    </div>

                    <div class="about-timeline">
                        <div class="about-timeline-line" aria-hidden="true">
                        </div>
                        <div class="about-timeline-item">
                            <span class="about-timeline-dot"></span>
                            <span class="about-timeline-year">2004</span>
                            <p>
                                처음으로 HTML과 PHP를 더듬어 페이지 한 장을
                                띄우던 손은 그 뒤로 줄곧 모양을 바꿔 왔습니다.
                            </p>
                        </div>
                        <div class="about-timeline-item">
                            <span class="about-timeline-dot"></span>
                            <span class="about-timeline-year">→</span>
                            <p>
                                정적인 페이지를 짜던 손이 어느새 서버를 세우고,
                                서버 아래에서 사용자를 들여다보고, 사용자 너머로
                                팀과 제품 전체를 그리는 일까지 닿았습니다.
                            </p>
                        </div>
                        <div class="about-timeline-item">
                            <span class="about-timeline-dot is-accent"></span>
                            <span class="about-timeline-year">now</span>
                            <p>
                                사람과 기계가 맞닿는 가장자리, 그 가장자리가
                                자꾸 넓어지는 곳을 따라 일해 왔습니다.<br />
                                프리랜서로 시작해 풀스택 엔지니어를 지나 CTO와 PM의
                                자리에도 앉아 보았고, 지금도 어느 한 곳에만 머물러
                                있지 않습니다.
                            </p>
                        </div>
                    </div>

                    <p class="about-portrait-outro">
                        블로그 바깥에서는 꼬냑 한 잔, 손에 잡히는 카메라 한 대,
                        SF 소설과 영화, 그리고 이국 타지의 오래된 골목… <br />
                        그 사이에서 또 다른 경험에 시간을 나눕니다.
                    </p>
                </div>
            </div>
        </section>

        <!-- ============ HOW I WRITE ============ -->
        <section class="about-section">
            <header class="about-section-head">
                <span class="about-section-num">03</span>
                <div>
                    <span class="about-section-kicker">principles</span>
                    <h2>어떻게 쓰는가</h2>
                </div>
                <svg
                    class="about-section-glyph"
                    viewBox="0 0 60 60"
                    aria-hidden="true"
                >
                    <rect
                        x="8"
                        y="8"
                        width="44"
                        height="44"
                        rx="8"
                        fill="none"
                        stroke="var(--color-accent)"
                        stroke-width="1.6"
                        stroke-dasharray="3 5"></rect>
                    <path
                        d="M18 30 L26 38 L42 22"
                        fill="none"
                        stroke="var(--color-accent)"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </header>

            <ul class="about-principles">
                <li>
                    <span class="about-principles-icon">
                        <svg viewBox="0 0 28 28" aria-hidden="true">
                            <circle
                                cx="14"
                                cy="14"
                                r="11"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.6"></circle>
                            <path
                                d="M14 7 L14 14 L19 17"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.6"
                                stroke-linecap="round"></path>
                        </svg>
                    </span>
                    <div>
                        <strong>직접 부서져 본 것을 씁니다.</strong>
                        <p>
                            새로운 주제를 무작정 던져보기 보다는 제가 알고 있는
                            것, 해온 것들을 씁니다.
                        </p>
                    </div>
                </li>
                <li>
                    <span class="about-principles-icon">
                        <svg viewBox="0 0 28 28" aria-hidden="true">
                            <rect
                                x="4"
                                y="6"
                                width="6"
                                height="16"
                                rx="1.5"
                                fill="currentColor"
                                fill-opacity="0.85"></rect>
                            <rect
                                x="11"
                                y="6"
                                width="6"
                                height="16"
                                rx="1.5"
                                fill="currentColor"
                                fill-opacity="0.55"></rect>
                            <rect
                                x="18"
                                y="6"
                                width="6"
                                height="16"
                                rx="1.5"
                                fill="currentColor"
                                fill-opacity="0.3"></rect>
                        </svg>
                    </span>
                    <div>
                        <strong>시리즈로 씁니다.</strong>
                        <p>한 번에 끝나지 않는 주제는 여러 편으로 나눕니다.</p>
                    </div>
                </li>
                <li>
                    <span class="about-principles-icon">
                        <svg viewBox="0 0 28 28" aria-hidden="true">
                            <path
                                d="M6 6 L22 6"
                                stroke="currentColor"
                                stroke-width="2.2"
                                stroke-linecap="round"></path>
                            <path
                                d="M6 13 L18 13"
                                stroke="currentColor"
                                stroke-width="1.6"
                                stroke-linecap="round"
                                stroke-opacity="0.6"></path>
                            <path
                                d="M6 19 L20 19"
                                stroke="currentColor"
                                stroke-width="1.6"
                                stroke-linecap="round"
                                stroke-opacity="0.4"></path>
                            <path
                                d="M6 25 L14 25"
                                stroke="currentColor"
                                stroke-width="1.6"
                                stroke-linecap="round"
                                stroke-opacity="0.25"></path>
                        </svg>
                    </span>
                    <div>
                        <strong>결론을 먼저 말합니다.</strong>
                        <p>
                            리드 단락에서 무엇을 다루고 무엇을 얻을 수 있는지
                            먼저 밝힙니다.
                        </p>
                    </div>
                </li>
                <li>
                    <span class="about-principles-icon">
                        <svg viewBox="0 0 28 28" aria-hidden="true">
                            <rect
                                x="5"
                                y="5"
                                width="8"
                                height="8"
                                rx="1.5"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.6"></rect>
                            <rect
                                x="15"
                                y="5"
                                width="8"
                                height="8"
                                rx="1.5"
                                fill="currentColor"></rect>
                            <rect
                                x="5"
                                y="15"
                                width="8"
                                height="8"
                                rx="1.5"
                                fill="currentColor"
                                fill-opacity="0.5"></rect>
                            <rect
                                x="15"
                                y="15"
                                width="8"
                                height="8"
                                rx="1.5"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.6"
                                stroke-dasharray="2 3"></rect>
                        </svg>
                    </span>
                    <div>
                        <strong>가져갈 수 있는 자산을 남깁니다.</strong>
                        <p>
