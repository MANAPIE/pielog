---
import type { ImageMetadata } from "astro";

interface Candidate {
    title: string;
    slug: string;
    thumbnail?: string;
    tags?: string[];
    summary?: string;
    description?: string;
}

interface Props {
    candidates: Array<{
        title: string;
        slug: string;
        thumbnail?: ImageMetadata;
        tags?: string[];
        summary?: string;
        description?: string;
    }>;
}

const { candidates } = Astro.props;

const serialized: Candidate[] = candidates.map((c) => ({
    title: c.title,
    slug: c.slug,
    thumbnail: c.thumbnail?.src,
    tags: c.tags,
    summary: c.summary,
    description: c.description,
}));

const initial = serialized[0];
---

{
    initial && (
        <section class="featured-section">
            <svg
                class="hero-bg"
                viewBox="0 0 820 540"
                preserveAspectRatio="xMidYMid slice"
                aria-hidden="true"
            >
                <defs>
                    <pattern
                        id="hero-bg-featured-dots"
                        x="0"
                        y="0"
                        width="24"
                        height="24"
                        patternUnits="userSpaceOnUse"
                    >
                        <circle cx="12" cy="12" r="1.2" fill="var(--color-dot)" />
                    </pattern>
                    <radialGradient
                        id="hero-bg-featured-halo-a"
                        cx="0.85"
                        cy="0.15"
                        r="0.7"
                    >
                        <stop
                            offset="0"
                            stop-color="var(--color-accent)"
                            stop-opacity="0.28"
                        />
                        <stop
                            offset="1"
                            stop-color="var(--color-accent)"
                            stop-opacity="0"
                        />
                    </radialGradient>
                    <radialGradient
                        id="hero-bg-featured-halo-b"
                        cx="0.08"
                        cy="0.92"
                        r="0.6"
                    >
                        <stop
                            offset="0"
                            stop-color="var(--color-accent-3)"
                            stop-opacity="0.34"
                        />
                        <stop
                            offset="1"
                            stop-color="var(--color-accent-3)"
                            stop-opacity="0"
                        />
                    </radialGradient>
                </defs>
                <rect width="820" height="540" fill="url(#hero-bg-featured-dots)" />
                <rect width="820" height="540" fill="url(#hero-bg-featured-halo-a)" />
                <rect width="820" height="540" fill="url(#hero-bg-featured-halo-b)" />
                <circle
                    cx="740"
                    cy="80"
                    r="220"
                    fill="none"
                    stroke="var(--color-line)"
                    stroke-width="1.4"
                />
                <circle
                    cx="740"
                    cy="80"
                    r="150"
                    fill="none"
                    stroke="var(--color-line)"
                    stroke-width="1.4"
                />
                <circle
                    cx="80"
                    cy="480"
                    r="180"
                    fill="none"
                    stroke="var(--color-line)"
                    stroke-width="1.4"
                />
                <g transform="rotate(8 410 270)">
                    <rect
                        x="40"
                        y="40"
                        width="120"
                        height="120"
                        fill="none"
                        stroke="var(--color-line)"
                        stroke-width="1.4"
                        stroke-dasharray="4 8"
                    />
                </g>
                <circle cx="720" cy="280" r="6" fill="var(--color-accent-2)" />
                <circle cx="744" cy="304" r="4" fill="var(--color-accent-3)" />
                <circle cx="700" cy="320" r="3" fill="var(--color-accent)" />
            </svg>
            <span class="section-kicker">// featured post_</span>
            <article class="featured-card" data-featured-card>
                <a
                    class="featured-card-link"
                    href={`/${initial.slug}/`}
                    data-featured-link
                    data-no-thumb={initial.thumbnail ? undefined : ""}
                >
                    {initial.thumbnail && (
                        <img
                            class="featured-card-thumbnail"
                            src={initial.thumbnail}
                            alt={initial.title}
                            data-featured-thumbnail
                        />
                    )}
                    <div class="featured-card-meta">
                        {initial.tags && initial.tags.length > 0 && (
                            <ul
                                class="featured-card-tags"
                                data-featured-tags
                            >
                                {initial.tags.map((tag) => (
                                    <li>{tag}</li>
                                ))}
                            </ul>
                        )}
                        <h2
                            class="featured-card-title"
                            data-featured-title
                        >
                            {initial.title}
                        </h2>
                        {(initial.summary || initial.description) && (
                            <p
                                class="featured-card-summary"
                                data-featured-summary
                            >
                                {initial.summary ?? initial.description}
                            </p>
                        )}
                        <p class="featured-card-button">read →</p>
                    </div>
                </a>
            </article>
            <script
                is:inline
                type="application/json"
                data-featured-candidates
                set:html={JSON.stringify(serialized)}
            />
            <script is:inline>
                (() => {
                    const node = document.querySelector(
                        "[data-featured-candidates]",
                    );
                    if (!node || !node.textContent) return;
                    let list;
                    try {
                        list = JSON.parse(node.textContent);
                    } catch (e) {
                        return;
                    }
                    if (!Array.isArray(list) || list.length <= 1) return;
                    const pick =
                        list[Math.floor(Math.random() * list.length)];
                    if (!pick || pick.slug === list[0].slug) return;

                    const card = document.querySelector(
                        "[data-featured-card]",
                    );
                    if (!card) return;
                    const link = card.querySelector("[data-featured-link]");
                    const thumb = card.querySelector(
                        "[data-featured-thumbnail]",
                    );
                    const tagsEl = card.querySelector(
                        "[data-featured-tags]",
                    );
                    const titleEl = card.querySelector(
                        "[data-featured-title]",
                    );
                    const summaryEl = card.querySelector(
                        "[data-featured-summary]",
                    );

                    if (link) {
                        link.href = `/${pick.slug}/`;
                        if (pick.thumbnail) {
                            link.removeAttribute("data-no-thumb");
                        } else {
                            link.setAttribute("data-no-thumb", "");
                        }
                    }
                    if (pick.thumbnail) {
                        if (thumb) {
                            thumb.src = pick.thumbnail;
                            thumb.alt = pick.title;
                        } else if (link) {
                            const img = document.createElement("img");
                            img.className = "featured-card-thumbnail";
                            img.src = pick.thumbnail;
                            img.alt = pick.title;
                            img.setAttribute("data-featured-thumbnail", "");
                            link.insertBefore(img, link.firstChild);
                        }
                    } else if (thumb) {
                        thumb.remove();
                    }
                    if (titleEl) titleEl.textContent = pick.title;
                    if (summaryEl) {
                        summaryEl.textContent =
                            pick.summary || pick.description || "";
                    }
                    if (tagsEl && pick.tags) {
                        tagsEl.replaceChildren(
                            ...pick.tags.map((tag) => {
                                const li = document.createElement("li");
                                li.textContent = tag;
                                return li;
                            }),
                        );
                    }
                })();
            </script>
        </section>
    )
}

<style lang="scss">
    @use "../styles/_variables.scss" as *;

    .featured-section {
        position: relative;
        isolation: isolate;
        margin-bottom: 40px;
        padding: 28px 28px 32px;
        border: 1px solid $color-border;
        background: $color-bg;
        overflow: hidden;

        @media (max-width: #{$bp-mobile - 1}) {
            padding: 20px 16px 24px;
        }
    }

    .featured-card {
        margin-bottom: 0;

        .featured-card-link {
            display: grid;
            grid-template-columns: minmax(280px, 360px) 1fr;
            gap: 0;
            background: $color-bg;
            border: 1px solid $color-line;
            box-shadow: 0px 4px 20px var(--color-shadow);
            color: $color-text;
            text-decoration: none;
            transition:
                box-shadow 0.15s ease,
                border-color 0.15s ease,
                transform 0.15s ease;

            &:hover {
                border-color: $color-accent;
                box-shadow: 0px 6px 22px var(--color-shadow-hover);
                transform: translateY(-2px);
                color: $color-text;
            }

            @media (max-width: #{$bp-narrow - 1}) {
                grid-template-columns: 1fr;
            }

            &[data-no-thumb] {
                grid-template-columns: 1fr;
            }
        }

        .featured-card-thumbnail {
            width: 100%;
            height: 100%;
            min-height: 240px;
            object-fit: cover;
            display: block;

            @media (max-width: #{$bp-narrow - 1}) {
                min-height: 0;
                aspect-ratio: 1200 / 630;
            }
        }

        .featured-card-meta {
            padding: 22px 24px;
            display: flex;
            flex-direction: column;
        }

        .featured-card-tags {
            font-size: 12px;
            line-height: 1.8;
        }

        .featured-card-title {
            font-size: 22px;
            font-weight: bold;
            color: $color-text;
            margin-bottom: 8px;
            line-height: 1.35;

            @media (max-width: #{$bp-mobile - 1}) {
                font-size: 18px;
            }
        }

        .featured-card-summary {
            font-size: 12px;
            color: $color-primary;
            flex: 1 1 auto;
            min-height: 160px;
        }

        .featured-card-button {
            font-size: 11px;
            font-weight: bold;
            font-family: "Courier New", Courier, monospace;
            margin-top: 14px;
        }
    }
</style>
