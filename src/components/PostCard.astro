---
import type { ImageMetadata } from "astro";

interface Props {
    title: string;
    slug: string;
    thumbnail?: ImageMetadata;
    tags?: string[];
    summary?: string;
}
const { title, slug, thumbnail, tags, summary } = Astro.props;
---

<div class="post-card">
    <a href={`/${slug}/`}>
        {
            thumbnail && (
                <img
                    class="post-card-thumbnail"
                    src={thumbnail.src}
                    alt={title}
                />
            )
        }
        <div class="post-card-meta">
            {
                tags && tags.length > 0 && (
                    <ul class="post-card-tags">
                        {tags.map((tag) => (
                            <li>{tag}</li>
                        ))}
                    </ul>
                )
            }
            <h3 class="post-card-title">{title}</h3>
            {summary && <p class="post-card-summary">{summary}</p>}
            <p class="post-card-button">read →</p>
        </div>
    </a>
</div>
