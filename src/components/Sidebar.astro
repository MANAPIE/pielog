---
import { getCollection } from "astro:content";
import ThemeToggle from "./ThemeToggle.astro";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tagCounts = posts.reduce<Record<string, number>>((acc, post) => {
  post.data.tags?.forEach((tag) => {
    acc[tag] = (acc[tag] ?? 0) + 1;
  });
  return acc;
}, {});
---

<span class="sidebar-button"></span>
<div class="sidebar-inner">
  <div class="sidebar-logo">
    <a href="/" class="site-title">
      <span class="emblem"></span>
      PIElog
    </a>
    <div class="site-subtitle">
      // thoughts & experiments<span class="blink">_</span>
    </div>
  </div>

  <div class="sidebar-categories">
    <h3 class="sidebar-section-title">CATEGORIES</h3>
    <ul class="category-tree">
      <li>
        <a href="/">Home</a>
      </li>
      <li>
        <a href="/tags/design">
          Design
          <span title="Post counts">{tagCounts["design"] ?? 0}</span>
        </a>
      </li>
      <li>
        <a href="/tags/develop">
          Develop
          <span title="Post counts">{tagCounts["develop"] ?? 0}</span>
        </a>
        <ul>
          <li>
            <a href="/tags/frontend">
              Frontend
              <span title="Post counts">{tagCounts["frontend"] ?? 0}</span>
            </a>
          </li>
          <li>
            <a href="/tags/backend">
              Backend
              <span title="Post counts">{tagCounts["backend"] ?? 0}</span>
            </a>
          </li>
          <li>
            <a href="/tags/infra">
              Infra
              <span title="Post counts">{tagCounts["infra"] ?? 0}</span>
            </a>
          </li>
          <li>
            <a href="/tags/devops">
              Devops
              <span title="Post counts">{tagCounts["devops"] ?? 0}</span>
            </a>
          </li>
          <li>
            <a href="/tags/ai">
              AI
              <span title="Post counts">{tagCounts["ai"] ?? 0}</span>
            </a>
          </li>
        </ul>
      </li>
      <li>
        <a href="/about">About</a>
      </li>
      <li>
        <a href="/rss.xml">RSS</a>
      </li>
    </ul>
  </div>

  <div class="sidebar-theme">
    <ThemeToggle />
  </div>

  <style lang="scss">
    @use "../styles/_variables.scss" as *;

    .sidebar-inner {
      padding: 20px;
    }

    .sidebar-button {
      position: absolute;
      right: -5px;
      top: 25px;
      display: block;
      width: 30px;
      height: 28px;
      background: url("/images/manapie-emblem-small.svg") transparent no-repeat;
      transition: opacity 0.3s ease;
    }


    .sidebar-logo {
      .site-title {
        font-size: 20px;
        font-weight: bold;
        color: $color-text;
        text-decoration: none;

        .emblem {
          display: inline-block;
          vertical-align: middle;
          width: 30px;
          height: 28px;
          background: url("/images/manapie-emblem-small.svg") transparent
            no-repeat;
          margin: 0 3px 2px -2px;
        }

      }

      .site-subtitle {
        font-family: "Courier New", Courier, monospace;
        font-size: 11px;
        color: $color-primary;
        margin-top: 5px;

        .blink {
          animation: blink 1s step-end infinite;
        }

        @keyframes blink {
          0%,
          100% {
            opacity: 1;
          }
          50% {
            opacity: 0;
          }
        }
      }
    }

    .sidebar-section-title {
      margin: 20px 0;
      font-weight: bold;
      font-size: 9px;
      letter-spacing: 30%;
      color: $color-text-muted;
    }

    .sidebar-theme {
      margin-top: 24px;
      padding-top: 16px;
      border-top: 1px solid $color-border;
    }

    .category-tree {
      font-size: 14px;

      a {
        color: $color-text;
        text-decoration: none;

        &:hover {
          text-decoration: underline;
        }
      }

      span {
        position: relative;
        top: -1px;
        display: inline-block;
        white-space: nowrap;
        padding: 0 4px;
        margin-left: 2px;
        background: $color-tree;
        border: 1px solid $color-border;
        border-radius: 100%;
        font-family: "Courier New", Courier, monospace;
        font-weight: bold;
        font-size: 11px;
        line-height: 16px;
        min-width: 8px;
      }

      li {
        list-style: none;
        font-weight: bold;
        padding: 2px 0;

        ul {
          margin: 4px 0;
        }

        li {
          font-weight: normal;
          border-left: 3px solid $color-tree;
          padding-left: 10px;
          margin-left: 5px;
        }
      }
    }
  </style>
</div>
