---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 4);

interface TocNode {
  slug: string;
  text: string;
  children: TocNode[];
}

const tree: TocNode[] = [];
for (const item of tocItems) {
  if (item.depth === 2) {
    tree.push({ slug: item.slug, text: item.text, children: [] });
  } else if (item.depth === 3 && tree.length > 0) {
    tree[tree.length - 1].children.push({
      slug: item.slug,
      text: item.text,
      children: [],
    });
  } else if (item.depth === 4 && tree.length > 0) {
    const lastH2 = tree[tree.length - 1];
    if (lastH2.children.length > 0) {
      lastH2.children[lastH2.children.length - 1].children.push({
        slug: item.slug,
        text: item.text,
        children: [],
      });
    }
  }
}
---

{
  tree.length > 0 && (
    <nav class="toc-tree" aria-label="목차">
      <span class="toc-indicator" aria-hidden="true" />
      <ul>
        {tree.map((node) => (
          <li>
            <a href={`#${node.slug}`}>{node.text}</a>
            {node.children.length > 0 && (
              <ul>
                {node.children.map((child) => (
                  <li>
                    <a href={`#${child.slug}`}>{child.text}</a>
                    {child.children.length > 0 && (
                      <ul>
                        {child.children.map((grandchild) => (
                          <li>
                            <a href={`#${grandchild.slug}`}>
                              {grandchild.text}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  const tocNav = document.querySelector(".toc-tree") as HTMLElement | null;
  const indicator = document.querySelector(
    ".toc-indicator",
  ) as HTMLElement | null;
  const asidePanel = document.querySelector(
    ".aside-panel",
  ) as HTMLElement | null;

  // Mutable — refreshed after any DOM augmentation (e.g. when React-rendered
  // charts mount their own <h3 id="…"> headings post-hydration).
  let headings: NodeListOf<Element> = document.querySelectorAll(
    ".post-content h2, .post-content h3, .post-content h4",
  );
  let tocItems: NodeListOf<Element> = document.querySelectorAll(".toc-tree li");

  function refreshLists() {
    headings = document.querySelectorAll(
      ".post-content h2, .post-content h3, .post-content h4",
    );
    tocItems = document.querySelectorAll(".toc-tree li");
  }

  // Inject any post-content h3 that has an id but isn't yet in the TOC.
  // Used for client-rendered headings (e.g. the chart gallery cards).
  function augmentToc() {
    if (!tocNav) return;
    const rootUl = tocNav.querySelector(":scope > ul");
    if (!rootUl) return;

    const h2s = Array.from(
      document.querySelectorAll(".post-content h2[id]"),
    ) as HTMLElement[];
    const h3s = Array.from(
      document.querySelectorAll(".post-content h3[id]"),
    ) as HTMLElement[];
    if (!h3s.length || !h2s.length) return;

    let mutated = false;
    h3s.forEach((h3) => {
      if (tocNav.querySelector(`a[href="#${CSS.escape(h3.id)}"]`)) return;

      // The closest preceding h2 in document order is the parent section.
      let parentH2: HTMLElement | null = null;
      for (const h2 of h2s) {
        if (
          h2.compareDocumentPosition(h3) & Node.DOCUMENT_POSITION_FOLLOWING
        ) {
          parentH2 = h2;
        }
      }
      if (!parentH2) return;

      const h2Link = tocNav.querySelector(
        `a[href="#${CSS.escape(parentH2.id)}"]`,
      );
      const h2Li = h2Link?.parentElement;
      if (!h2Li) return;

      let h3Ul = h2Li.querySelector(":scope > ul");
      if (!h3Ul) {
        h3Ul = document.createElement("ul");
        h2Li.appendChild(h3Ul);
      }

      // Preserve document order: find an existing child whose linked heading
      // appears later than this h3, and insert before it.
      const newLi = document.createElement("li");
      const newA = document.createElement("a");
      newA.href = `#${h3.id}`;
      newA.textContent = h3.textContent ?? h3.id;
      newLi.appendChild(newA);

      const existingLis = Array.from(h3Ul.children) as HTMLElement[];
      let insertBefore: HTMLElement | null = null;
      for (const li of existingLis) {
        const a = li.querySelector("a");
        if (!a) continue;
        const targetId = a.getAttribute("href")?.slice(1);
        if (!targetId) continue;
        const target = document.getElementById(targetId);
        if (
          target &&
          h3.compareDocumentPosition(target) & Node.DOCUMENT_POSITION_FOLLOWING
        ) {
          insertBefore = li;
          break;
        }
      }
      h3Ul.insertBefore(newLi, insertBefore);
      mutated = true;
    });

    if (mutated) refreshLists();
  }

  function moveIndicator(li: Element) {
    if (!indicator || !tocNav) return;
    const link = li.querySelector("a");
    if (!link) return;
    const navRect = tocNav.getBoundingClientRect();
    const linkRect = link.getBoundingClientRect();
    const top =
      linkRect.top -
      navRect.top +
      linkRect.height / 2 -
      indicator.offsetHeight / 2;
    indicator.style.top = `${top}px`;
    indicator.style.opacity = "1";

    if (asidePanel) {
      const margin = 50;
      const panelRect = asidePanel.getBoundingClientRect();
      if (linkRect.top < panelRect.top + margin) {
        asidePanel.scrollBy({
          top: linkRect.top - panelRect.top - margin,
          behavior: "smooth",
        });
      } else if (linkRect.bottom > panelRect.bottom - margin) {
        asidePanel.scrollBy({
          top: linkRect.bottom - panelRect.bottom + margin,
          behavior: "smooth",
        });
      }
    }
  }

  function setActive() {
    const scrollY = window.scrollY;
    let current: Element | null = null;

    headings.forEach((h) => {
      if ((h as HTMLElement).offsetTop - 100 <= scrollY) {
        current = h;
      }
    });

    if (!current) return;

    tocItems.forEach((l) => l.classList.remove("is-active"));
    document
      .querySelectorAll(".toc-tree a[aria-current]")
      .forEach((a) => a.removeAttribute("aria-current"));
    const activeLink = document.querySelector(
      `.toc-tree a[href="#${CSS.escape((current as HTMLElement).id)}"]`,
    );
    const activeLi = activeLink?.parentElement;
    if (activeLi && activeLink) {
      activeLi.classList.add("is-active");
      activeLink.setAttribute("aria-current", "location");
      moveIndicator(activeLi);
    }
  }

  // Initial pickup of any h3 already in the DOM (rare on first paint when
  // charts use client:only, but cheap), then start the scroll spy.
  augmentToc();
  if (headings.length > 0 && tocItems.length > 0) {
    window.addEventListener("scroll", setActive, { passive: true });
    setActive();
  }

  // React-rendered chart cards mount h3 nodes after hydration. Watch for
  // them and merge into the TOC as they appear.
  const postContent = document.querySelector(".post-content");
  if (postContent) {
    let pending = false;
    const scheduleAugment = () => {
      if (pending) return;
      pending = true;
      requestAnimationFrame(() => {
        pending = false;
        augmentToc();
        setActive();
      });
    };
    const mo = new MutationObserver((records) => {
      for (const r of records) {
        for (const n of Array.from(r.addedNodes)) {
          if (
            n.nodeType === 1 &&
            ((n as Element).tagName === "H3" ||
              (n as Element).querySelector?.("h3"))
          ) {
            scheduleAugment();
            return;
          }
        }
      }
    });
    mo.observe(postContent, { childList: true, subtree: true });
  }
</script>

<style is:global lang="scss">
  @use "../styles/_variables.scss" as *;

  .toc-tree {
    position: relative;
    font-size: 0.8125rem;
    padding: 60px 20px 20px 20px;
    opacity: 0.7;
    transition: opacity 0.25s ease;

    &:hover,
    &:focus-within {
      opacity: 1;
    }

    .toc-indicator {
      position: absolute;
      left: 0;
      top: 60px;
      font-size: 0.5rem;
      line-height: 26px;
      opacity: 0;
      transition:
        top 0.3s ease,
        opacity 0.3s ease;
      pointer-events: none;
      width: 0;
      height: 0;
      border-style: solid;
      border-width: 6px 0px 6px 10px;
      border-color: transparent transparent transparent $color-accent;
    }

    a {
      display: block;
      color: $color-text;
      text-decoration: none;
      padding: 3px 6px;
      margin: -3px -6px;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      transition:
        background-color 0.15s ease,
        color 0.15s ease;

      &:hover,
      &:focus-visible {
        background: $color-surface;
        color: $color-accent;
      }
    }

    li {
      position: relative;
      list-style: none;
      font-weight: bold;
      line-height: 26px;
      margin-bottom: 5px;

      ul {
        margin: 4px 0;
      }

      li {
        font-weight: normal;
        border-left: 3px solid $color-tree;
        padding-left: 10px;
        margin-left: 5px;
        margin-bottom: 0;
      }
    }
  }
</style>
