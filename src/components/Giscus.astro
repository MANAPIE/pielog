---
const lightTheme = new URL("/giscus/light.css", Astro.site).toString();
const darkTheme = new URL("/giscus/dark.css", Astro.site).toString();
---

<section
    class="giscus-wrapper"
    aria-label="댓글"
    data-giscus-light={lightTheme}
    data-giscus-dark={darkTheme}
>
    <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo="MANAPIE/pielog"
        data-repo-id="R_kgDOSBJGEA"
        data-category="Comments"
        data-category-id="DIC_kwDOSBJGEM4C6ud6"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme={lightTheme}
        data-lang="ko"
        crossorigin="anonymous"
        async></script>
</section>

