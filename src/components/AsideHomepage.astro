---
import { getCollection } from "astro:content";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const recentPosts = posts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 10);
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const sortedTags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);
const maxCount = sortedTags[0]?.[1] ?? 0;
const minCount = sortedTags[sortedTags.length - 1]?.[1] ?? 0;
const tagTier = (count: number) => {
  if (maxCount === minCount) return 3;
  const ratio = (count - minCount) / (maxCount - minCount);
  return Math.min(5, Math.max(1, Math.ceil(ratio * 5))) || 1;
};
const allTags = sortedTags.map(([tag, count]) => ({
  tag,
  count,
  tier: tagTier(count),
}));
---

<div class="aside-home">
  <section class="aside-section">
    <span class="section-kicker">// top reads_</span>
    <ul class="aside-section-list" id="top-reads">
      <li class="recent-post-item">
        <span class="recent-post-num" style="font-size:12px;">loading...</span>
      </li>
    </ul>
  </section>

  <section class="aside-section">
    <span class="section-kicker">// recent posts_</span>
    {
      recentPosts.length > 0 ? (
        <ul class="aside-section-list">
          {recentPosts.map((post, i) => (
            <li class="recent-post-item">
              <a href={`/${post.id}/`} class="recent-post-link">
                <span class="recent-post-num">#{i + 1}</span>
                <span class="recent-post-title">{post.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="aside-placeholder">준비 중</p>
      )
    }
  </section>

  <section class="aside-section">
    <span class="section-kicker">// tag index_</span>
    {
      allTags.length > 0 ? (
        <div class="tag-list">
          {allTags.map(({ tag, count, tier }) => (
            <a
              href={`/tags/${tag}/`}
              class={`tag-link tag-tier-${tier}`}
              title={`${count} posts`}
            >
              {tag}
            </a>
          ))}
        </div>
      ) : (
        <p class="aside-placeholder">준비 중</p>
      )
    }
  </section>

  <section class="aside-section">
    <span class="section-kicker">// visitors_</span>
    <ul class="aside-section-list">
      <li class="recent-post-item">
        <span class="recent-post-num"
          >TODAY <span id="visitors-today">-</span></span
        >
      </li>
      <li class="recent-post-item">
        <span class="recent-post-num"
          >TOTAL <span id="visitors-total">-</span></span
        >
      </li>
    </ul>
  </section>
</div>

<script>
  // Fetch visitor counts
  fetch("/api/views")
    .then((r) => r.json())
    .then((data) => {
      const todayEl = document.getElementById("visitors-today");
      const totalEl = document.getElementById("visitors-total");
      if (todayEl) todayEl.textContent = data.todayVisitors.toLocaleString();
      if (totalEl) totalEl.textContent = data.totalVisitors.toLocaleString();
    })
    .catch(() => {});

  // Fetch top reads
  fetch("/api/top-reads")
    .then((r) => r.json())
    .then((posts) => {
      const container = document.getElementById("top-reads");
      if (!container) return;
      if (posts.length === 0) {
        container.innerHTML =
          '<li class="recent-post-item"><span class="recent-post-num" style="font-size:12px;">아직 데이터가 없습니다</span></li>';
        return;
      }
      container.innerHTML = posts
        .map(
          (p: { slug: string; title: string; views: number }, i: number) =>
            `<li class="recent-post-item">
              <a href="/${p.slug}/" class="recent-post-link">
                <span class="recent-post-num">#${i + 1}</span>
                <span class="recent-post-title">${p.title}</span>
              </a>
            </li>`,
        )
        .join("");
    })
    .catch(() => {});
</script>

<style lang="scss">
  @use "../styles/_variables.scss" as *;

  .aside-home {
    padding: 5px 20px 20px;
  }

  .aside-section {
    padding: 20px 0;

    & + .aside-section {
      border-top: 1px solid $color-border;
    }
  }

  .aside-placeholder {
    font-size: 12px;
  }

  .aside-section-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .recent-post-item + .recent-post-item,
  :global(#top-reads .recent-post-item + .recent-post-item) {
    margin-top: 4px;
  }

  .recent-post-link,
  :global(#top-reads .recent-post-link) {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 13px;
    color: inherit;
    text-decoration: none;
    padding: 3px 6px;
    margin: 0 -6px;
    border-radius: 3px;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;

    &:hover {
      background: $color-surface;
      color: $color-accent;
    }
  }

  .recent-post-num,
  :global(#top-reads .recent-post-num) {
    font-family: "Courier New", Courier, monospace;
    font-size: 13px;
    color: $color-text-muted;
    flex-shrink: 0;
    min-width: 2.5ch;
    font-weight: bold;
  }

  .recent-post-title,
  :global(#top-reads .recent-post-title) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tag-list {
    font-size: 12px;
    line-height: 1.8;
  }

  .tag-link {
    line-height: 1.6;
  }

  .tag-tier-1 {
    font-size: 11px;
  }
  .tag-tier-2 {
    font-size: 13px;
  }
  .tag-tier-3 {
    font-size: 15px;
  }
  .tag-tier-4 {
    font-size: 17px;
  }
  .tag-tier-5 {
    font-size: 19px;
  }
</style>
